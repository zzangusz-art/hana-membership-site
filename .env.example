# ── 필수 ──
PORT=3000
# Railway Volume 마운트 경로. 없으면 ./data 사용 (재배포 시 초기화되므로 운영은 반드시 볼륨)
DATA_DIR=/data
# 관리자 로그인 토큰 서명키 (아무 긴 문자열)
JWT_SECRET=change-me-to-a-long-random-string
# 최초 관리자 계정 (DB에 관리자가 없을 때 1회만 생성)
ADMIN_ID=admin
ADMIN_PW=hana1234!

# ── 사이트 ──
# 배포 도메인 (canonical·sitemap·JSON-LD에 사용). 끝에 / 없이.
SITE_URL=https://www.hanamarket.co.kr

# ── 콘텐츠 자동생성 (하나만 있어도 됨. 없으면 템플릿 모드로 시세 리포트·골프장 소개만 자동 발행) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── 인블로그 (대시보드 → 설정 → API 키. Team 플랜 이상에서 동작) ──
INBLOG_API_KEY=

# ── 선택 ──
# 네이버 서치어드바이저 / 구글 서치콘솔 소유확인 메타태그 값
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
# GA4 측정 ID
GA_MEASUREMENT_ID=

# 리포트 전후 스크린샷용 크롬 경로(Railway는 /usr/bin/chromium 자동 탐지, 로컬 Windows는 Chrome/Edge 자동 탐지)
PUPPETEER_EXECUTABLE_PATH=
